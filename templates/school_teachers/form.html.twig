{% extends is_granted('ROLE_ADMIN') ? 'admin/_layout.html.twig' : 'principal/_layout.html.twig' %}

{% set heading = teacher ? 'Edit teacher' : 'New teacher' %}

{% block title %}{{ heading }} · ZIM School{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>{{ heading }}</h1>
            <p>{{ school.name }}{{ teacher ? '' : ' · A temporary password is created and shown once after saving.' }}</p>
        </div>
    </div>

    <div class="card form-card">
        {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
            {{ form_row(form.fullName) }}
            {{ form_row(form.username) }}

            <div class="form-actions">
                <button class="btn btn--primary" type="submit">{{ teacher ? 'Save teacher' : 'Create teacher' }}</button>
                <a class="link-muted" href="{{ path('school_teachers', {id: school.id}) }}">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
