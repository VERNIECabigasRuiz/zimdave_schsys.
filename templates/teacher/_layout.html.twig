{% extends 'base.html.twig' %}

{% block body_class %}admin-page{% endblock %}

{% set route = app.request.attributes.get('_route') %}

{% macro nav_link(label, url, active) %}
    <a class="sidebar__link{{ active ? ' is-active' }}" href="{{ url }}"{{ active ? ' aria-current="page"' }}>{{ label }}</a>
{% endmacro %}

{% block body %}
    <div class="admin">
        <aside class="sidebar">
            <a class="sidebar__brand" href="{{ path('teacher_dashboard') }}">
                <span class="avatar avatar--brand">Z</span>
                <span>
                    <strong>ZIM School</strong>
                    <small>Teacher</small>
                </span>
            </a>

            <nav class="sidebar__nav" aria-label="Teacher">
                {{ _self.nav_link('Dashboard', path('teacher_dashboard'), route == 'teacher_dashboard') }}
                {% if has_teaching_load(app.user) %}
                    {{ _self.nav_link('My Teaching Load', path('teacher_load'), route starts with 'teacher_load') }}
                    {{ _self.nav_link('My Grades', path('teacher_grades'), route starts with 'teacher_grades') }}
                {% endif %}
                {% if advises_section(app.user) %}
                    {% set attendance_route = route starts with 'teacher_class_attendance' or route == 'teacher_class_sf2' %}
                    {% set nutrition_route = route starts with 'teacher_class_nutrition' or route == 'teacher_class_sf8' %}
                    {{ _self.nav_link('My class', path('teacher_class'), route starts with 'teacher_class' and not attendance_route and not nutrition_route) }}
                    {{ _self.nav_link('Attendance', path('teacher_class_attendance'), attendance_route) }}
                    {{ _self.nav_link('Nutrition', path('teacher_class_nutrition'), nutrition_route) }}
                {% endif %}
                {{ _self.nav_link('My Profile', path('profile_show'), route starts with 'profile_') }}
            </nav>

            <a class="sidebar__me" href="{{ path('app_change_password') }}" title="Change password">
                {% if app.user.photoPath %}<img class="avatar avatar--photo" src="{{ asset(app.user.photoPath) }}" alt="">{% else %}<span class="avatar avatar--green">{{ app.user.initials }}</span>{% endif %}
                <span>
                    <strong>{{ app.user.fullName }}</strong>
                    <small>{{ app.user.roleLabel }}</small>
                </span>
            </a>
        </aside>

        <div class="admin__main">
            <header class="topbar">
                <span></span>
                <div class="topbar__actions">
                    {% if app.user.photoPath %}<img class="avatar avatar--photo" src="{{ asset(app.user.photoPath) }}" alt="" title="{{ app.user.fullName }}">{% else %}<span class="avatar" title="{{ app.user.fullName }}">{{ app.user.initials }}</span>{% endif %}
                    <a class="topbar__logout" href="{{ path('app_logout') }}">Logout</a>
                </div>
            </header>

            <main class="content">
                {% include 'admin/_flashes.html.twig' %}
                {% block content %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}
