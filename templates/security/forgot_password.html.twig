{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Forgot password · ZIM School{% endblock %}

{% block card %}
    <h2 class="auth-card__title">Forgot password?</h2>

    <p class="auth-card__text">
        Your account is managed by the school. Please contact your administrator and ask them to reset your password.
    </p>
    <p class="auth-card__text">
        They will give you a temporary password, and you will be asked to set a new one when you sign in.
    </p>

    <a class="btn btn--primary btn--block" href="{{ path('app_login') }}">Back to sign in</a>
{% endblock %}
