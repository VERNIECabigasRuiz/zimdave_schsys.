{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Set a new password · ZIM School{% endblock %}

{% block lead %}
    {% if first_time %}
        Hi {{ app.user.fullName }}! Before you continue, please replace the temporary password your administrator gave you.
    {% else %}
        Choose a new password for your account.
    {% endif %}
{% endblock %}

{% block card %}
    <h2 class="auth-card__title">{{ first_time ? 'Set a new password' : 'Change password' }}</h2>

    {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
        {% if form.currentPassword is defined %}
            {{ form_row(form.currentPassword) }}
        {% endif %}
        {{ form_row(form.plainPassword.first, {help: 'At least 8 characters, with at least one letter and one number.'}) }}
        {{ form_row(form.plainPassword.second) }}

        <button class="btn btn--primary btn--block" type="submit">Save password</button>
    {{ form_end(form) }}

    <p class="auth-card__link"><a href="{{ path('app_logout') }}">Sign out</a></p>
{% endblock %}
