{# Grade change requests, newest first. Needs requests (GradeChangeRequest list) and can_withdraw: whether this page
   offers Withdraw on a pending request (still only to whoever may withdraw it). #}
{% import 'grades/_change_request_macros.html.twig' as change_request %}
{% if requests is not empty %}
    <section class="card form-card change-requests" aria-label="Change requests">
        <h2 class="section-title section-title--flush">Change requests</h2>
        <ul class="change-requests__list">
            {% for change in requests %}
                <li class="change-requests__item">
                    {{ change_request.details(change) }}
                    {% if can_withdraw and change.pending and is_granted('GRADE_CHANGE_WITHDRAW', change) %}
                        <form method="post" action="{{ path('teacher_grades_change_withdraw', {request: change.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('grade-change-withdraw-' ~ change.id) }}">
                            <button class="btn btn--sm btn--ghost" type="submit">Withdraw</button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
