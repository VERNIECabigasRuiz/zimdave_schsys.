{% extends 'teacher/_layout.html.twig' %}

{% block title %}My Grades · ZIM School{% endblock %}

{% macro status_badge(status) %}
    {% set tone = {open: 'badge--green', locked: 'badge--rose', unlocked: 'badge--amber'}[status.value] ?? '' %}
    <span class="badge {{ tone }}">{{ status.label }}</span>
{% endmacro %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>My Grades</h1>
            <p>{% if school_year %}S.Y. {{ school_year.name }} · {% endif %}Period grades of the classes you teach</p>
        </div>
    </div>

    {% if graded is empty and ungraded is empty %}
        <div class="card empty">No teaching load yet.</div>
    {% endif %}

    {% if graded is not empty %}
        <div class="card table-card">
            <table class="table grade-loads">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Section</th>
                        {% for period in periods %}<th>{{ period.label }}</th>{% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in graded %}
                        <tr>
                            <td>{{ row.load.subject.name }}</td>
                            <td>{{ row.load.section.label }}</td>
                            {% for cell in row.cells %}
                                <td>
                                    <a href="{{ path('teacher_grades_sheet', {load: row.load.id, period: cell.period.id}) }}">{{ cell.graded }} / {{ cell.listed }}</a>
                                    {{ _self.status_badge(cell.status) }}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if ungraded is not empty %}
        <h2 class="section-title">Not graded here yet</h2>
        <p class="muted">Kindergarten and Senior High School grades aren't entered in ZIM School yet.</p>
        <div class="card table-card">
            <table class="table grade-loads--ungraded">
                <thead>
                    <tr><th>Subject</th><th>Section</th></tr>
                </thead>
                <tbody>
                    {% for load in ungraded %}
                        <tr>
                            <td>{{ load.subject.name }}</td>
                            <td>{{ load.section.label }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
