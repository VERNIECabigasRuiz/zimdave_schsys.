{# Styles shared by both ID layouts. Sizes in mm/pt; every block is placed absolutely inside a 54 × 86 mm card. #}
<style>
    * { margin: 0; padding: 0; }
    body { font-family: 'DejaVu Sans', sans-serif; color: #1f2933; }
    .card { position: absolute; width: 54mm; height: 86mm; overflow: hidden; background: #ffffff; }
    .card--front, .card--back { border: 0.15mm solid #c9d2e3; }
    .abs { position: absolute; left: 0; width: 54mm; text-align: center; }

    /* front */
    .band { position: absolute; left: 0; top: 0; width: 54mm; height: 25mm; background: #0b3d91; }
    .gold { position: absolute; left: 0; top: 25mm; width: 54mm; height: 0.9mm; background: #f2b705; }
    .seal, .logo { position: absolute; top: 2mm; width: 10mm; height: 10mm; }
    .seal { left: 2.2mm; }
    .logo { right: 2.2mm; }
    .gov { top: 2.6mm; color: #ffffff; line-height: 1.25; }
    .gov__republic { font-size: 4.3pt; letter-spacing: 0.15pt; }
    .gov__deped { font-size: 5.6pt; font-weight: bold; }
    .gov__region { font-size: 4.2pt; color: #d6e2f7; }
    .school { top: 13.2mm; left: 2mm; width: 50mm; color: #ffffff; font-size: 6.4pt; font-weight: bold; line-height: 1.15; }
    .school__id { display: block; margin-top: 0.6mm; color: #f2b705; font-size: 4.6pt; font-weight: bold; letter-spacing: 0.3pt; }
    .photo { position: absolute; left: 15.5mm; top: 28.5mm; width: 23mm; height: 29.6mm; border: 0.5mm solid #ffffff; outline: 0.2mm solid #c9d2e3; background: #e6ebf2; }
    .photo img { width: 23mm; height: 29.6mm; }
    /* no photo: a grey head and shoulders */
    .silhouette__head { position: absolute; left: 7mm; top: 6.5mm; width: 9mm; height: 9mm; border-radius: 4.5mm; background: #b8c3d3; }
    .silhouette__body { position: absolute; left: 3mm; top: 17.5mm; width: 17mm; height: 12.1mm; border-radius: 8mm 8mm 0 0; background: #b8c3d3; }
    /* name, LRN and grade flow, so a name on two lines pushes the rest down */
    .who { top: 59.6mm; left: 2mm; width: 50mm; }
    .name { color: #0b3d91; font-weight: bold; line-height: 1.1; margin-bottom: 0.9mm; }
    .name--1 { font-size: 8.5pt; }
    .name--2 { font-size: 7.4pt; }
    .name--3 { font-size: 6.4pt; }
    .lrn { font-size: 6pt; letter-spacing: 0.3pt; line-height: 1.3; }
    .lrn b { color: #0b3d91; }
    .grade { font-size: 6pt; font-weight: bold; line-height: 1.3; }
    .sign { top: 75.2mm; left: 12mm; width: 30mm; border-top: 0.2mm solid #52606d; font-size: 4.2pt; color: #52606d; padding-top: 0.4mm; }
    .foot { position: absolute; left: 0; top: 79.6mm; width: 54mm; height: 6.4mm; background: #0b3d91; }
    .foot__text { top: 81.2mm; color: #ffffff; font-size: 6pt; font-weight: bold; letter-spacing: 0.5pt; }
    .foot__text span { color: #f2b705; }

    /* back */
    .backhead { position: absolute; left: 0; top: 0; width: 54mm; height: 6mm; background: #0b3d91; }
    .backhead__text { top: 1.5mm; color: #ffffff; font-size: 5pt; font-weight: bold; letter-spacing: 0.5pt; }
    .backgold { position: absolute; left: 0; top: 6mm; width: 54mm; height: 0.6mm; background: #f2b705; }
    .block { left: 3.5mm; width: 47mm; text-align: left; }
    .label { font-size: 4.3pt; color: #52606d; text-transform: uppercase; letter-spacing: 0.25pt; }
    .value { font-size: 6.2pt; font-weight: bold; line-height: 1.2; }
    .value--small { font-size: 5.4pt; font-weight: normal; }
    .emergency { top: 8.4mm; }
    .address { top: 21.4mm; }
    .qr { position: absolute; left: 18mm; top: 30mm; width: 18mm; height: 18mm; }
    .qr__lrn { top: 48.4mm; font-size: 4.6pt; color: #52606d; letter-spacing: 0.4pt; }
    .head { top: 57.5mm; left: 8mm; width: 38mm; border-top: 0.2mm solid #52606d; padding-top: 0.5mm; }
    .head__name { font-size: 6pt; font-weight: bold; }
    .head__role { font-size: 4.3pt; color: #52606d; }
    .valid { top: 65mm; font-size: 5.4pt; font-weight: bold; color: #0b3d91; }
    .property { position: absolute; left: 0; top: 70.5mm; width: 54mm; height: 15.5mm; background: #eef3fb; }
    .property__text { top: 72mm; left: 3mm; width: 48mm; font-size: 4.4pt; line-height: 1.35; color: #3e4c59; }

    /* paper sheets */
    .page { position: relative; page-break-after: always; }
    .page:last-child { page-break-after: auto; }
    .cut { position: absolute; background: #9aa5b1; }
    .empty { padding: 30mm 20mm; font-size: 12pt; color: #52606d; }
</style>
