{% extends 'admin/_layout.html.twig' %}

{% set heading = announcement ? 'Edit announcement' : 'New announcement' %}

{% block title %}{{ heading }} · ZIM School{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>{{ heading }}</h1>
        </div>
    </div>

    <div class="card form-card">
        {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
            {{ form_row(form.title) }}
            {{ form_row(form.audience) }}
            {{ form_row(form.body) }}

            <div class="form-actions">
                <button class="btn btn--primary" type="submit">{{ announcement ? 'Save changes' : 'Post announcement' }}</button>
                <a class="link-muted" href="{{ path('admin_announcements') }}">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
