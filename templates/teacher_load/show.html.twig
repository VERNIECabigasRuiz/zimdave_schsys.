{% extends layout %}

{% block title %}Teaching load · {{ teacher.fullName }} · ZIM School{% endblock %}

{% block content %}
    {% set route = self ? 'teacher_load' : 'school_teacher_load' %}
    {% set params = self ? {} : {id: school.id, teacher: teacher.id} %}
    <div class="page-head">
        <div>
            <h1>{{ self ? 'My Teaching Load' : teacher.fullName }}</h1>
            <p>{% if school %}{{ school.name }}{% endif %}{% if school_year %} · S.Y. {{ school_year.name }}{% endif %} · Teaching load</p>
        </div>
        {% if not self and school %}
            <div class="row-actions">
                <a class="btn btn--ghost" href="{{ path('school_teachers', {id: school.id}) }}">Back to teachers</a>
            </div>
        {% endif %}
    </div>

    {% if week is null or week.periods is empty or week.loads is empty and not has_semesters %}
        <div class="card empty">No teaching load yet.</div>
    {% else %}
        {% if has_semesters %}
            <nav class="filters" aria-label="Semester">
                {% for t in [1, 2] %}
                    <a class="btn btn--sm {{ t == term ? 'btn--primary' : 'btn--ghost' }}"
                       href="{{ path(route, params|merge({term: t})) }}">{{ t == 1 ? '1st' : '2nd' }} sem</a>
                {% endfor %}
            </nav>
        {% endif %}

        <div class="card table-card">
            <table class="table">
                <thead>
                    <tr><th>Subject</th><th>Section</th><th>Periods per week</th></tr>
                </thead>
                <tbody>
                    {% for load in week.loads %}
                        <tr>
                            <td>{{ load.subjectName }}</td>
                            <td>{{ load.sectionLabel }}</td>
                            <td>{{ load.perWeek ?? '—' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="empty">No teaching load this semester.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <p><strong>Total: {{ week.totalPerWeek }} {{ week.totalPerWeek == 1 ? 'period' : 'periods' }} per week</strong></p>

        <section class="card table-card" aria-label="Weekly timetable">
            <table class="table timetable-grid">
                <thead>
                    <tr>
                        <th><span class="visually-hidden">Period</span></th>
                        {% for day in week.days %}<th>{{ day.label }}</th>{% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for period in week.periods %}
                        <tr data-period-id="{{ period.id }}"{% if period.isBreak %} class="timetable-break"{% endif %}>
                            <th scope="row">
                                {{ period.label }}
                                {% if period.startsAt %}<br><span class="muted">{{ period.startsAt }}–{{ period.endsAt }}</span>{% endif %}
                            </th>
                            {% if period.isBreak %}
                                <td colspan="{{ week.days|length }}" class="muted">{{ period.label }}</td>
                            {% else %}
                                {% for day in week.days %}
                                    {% set found = null %}
                                    {% for cell in week.cells|filter(c => c.day == day.value and c.periodId == period.id) %}{% set found = cell %}{% endfor %}
                                    {% if found %}
                                        <td class="timetable-cell timetable-cell--filled">
                                            <strong>{{ found.name }}</strong><br><span class="muted">{{ found.sectionLabel }}</span>
                                        </td>
                                    {% else %}
                                        <td class="timetable-cell"></td>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    {% endif %}
{% endblock %}
