{% extends is_granted('ROLE_TEACHER') ? '@Core/teacher/_layout.html.twig' : '@Core/principal/_layout.html.twig' %}

{# The signed-in teacher's or principal's own ID. Needs card (StaffIdCard), form, missing (photo/position),
   can_print, is_principal, division (principals: the Divisions entry or null) and school. #}

{% block title %}My ID · ZIM School{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>My ID</h1>
            <p>Print at 100% (actual size, not "fit to page"), then cut along the grey lines.</p>
        </div>
        <div class="row-actions">
            {% for size, label in {big: 'Big ID (PDF)', small: 'Small ID (PDF)'} %}
                {% if can_print %}
                    <a class="btn btn--primary" href="{{ path('my_id_pdf', {size: size}) }}" data-turbo="false">{{ label }}</a>
                {% else %}
                    <button class="btn btn--primary" type="button" disabled>{{ label }}</button>
                {% endif %}
            {% endfor %}
        </div>
    </div>

    {% if 'photo' in missing %}
        <div class="alert alert--error" role="alert">No photo yet. Add one in <a href="{{ path('profile_show') }}">My Profile</a> before printing.</div>
    {% endif %}
    {% if 'position' in missing %}
        <div class="alert alert--error" role="alert">
            No current position. {% if is_principal %}Add a row up to the present in <a href="{{ path('principal_service_record') }}">your service record</a>.{% else %}Ask your principal to add a row up to the present in your service record.{% endif %}
        </div>
    {% endif %}
    {% if is_principal %}
        {% if division is null %}
            <div class="alert alert--warning" role="status">No Divisions entry for {{ school.region }} · {{ school.division }} yet, so the Superintendent's lines print blank. Ask the administrator to add it.</div>
        {% elseif card.headSignature is null %}
            <div class="alert alert--warning" role="status">The Superintendent's signature isn't uploaded yet; a blank space prints. Ask the administrator.</div>
        {% endif %}
    {% elseif card.headName is null %}
        <div class="alert alert--warning" role="status">Your school has no principal this school year, so the head's lines print blank.</div>
    {% elseif card.headSignature is null %}
        <div class="alert alert--warning" role="status">Your principal hasn't uploaded an ID signature yet (School Profile); a blank space prints.</div>
    {% endif %}

    <div class="card form-card">
        <dl class="details">
            <div><dt>Name</dt><dd>{{ card.fullName }}</dd></div>
            <div><dt>Big name</dt><dd>{{ card.callName }}</dd></div>
            <div><dt>Position</dt><dd>{{ card.position ?? '—' }}</dd></div>
            <div><dt>Employee no.</dt><dd>{{ card.employeeNo ?? '—' }}</dd></div>
            <div><dt>TIN · PhilHealth · Pag-IBIG</dt><dd>{{ card.tin ?? '—' }} · {{ card.philhealthNo ?? '—' }} · {{ card.pagibigNo ?? '—' }}</dd></div>
            <div><dt>Blood type</dt><dd>{{ card.bloodType ?? '—' }}</dd></div>
            <div><dt>Signed by</dt><dd>{{ card.headName ?? '—' }}{% if card.headPosition %} · {{ card.headPosition }}{% endif %}</dd></div>
        </dl>
        <p class="form-note">Name, numbers and blood type come from your PDS in <a href="{{ path('profile_show') }}">My Profile</a>.</p>
    </div>

    <div class="card form-card">
        <h2>ID details</h2>
        {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
            {{ form_row(form.callName) }}
            <div class="form-grid">
                {{ form_row(form.emergencyName) }}
                {{ form_row(form.emergencyContact) }}
            </div>
            {{ form_row(form.gsisPolicyNo) }}
            <div class="form-actions">
                <button class="btn btn--primary" type="submit">Save ID details</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
