{% extends is_granted('ROLE_TEACHER') ? 'teacher/_layout.html.twig' : 'principal/_layout.html.twig' %}

{# A lesson plan, read-only. Needs plan. #}

{% block title %}Lesson plan · {{ plan.topic }} · ZIM School{% endblock %}

{% set load = plan.load %}
{% set labels = {objectives: 'Learning objectives', learnerContext: 'Learner context', preLesson: 'Pre-lesson', flow: 'Flow', resources: 'Learning resources', integration: 'Opportunities for integration', formativeAssessment: 'Formative assessment', extendedLearning: 'Extended learning opportunities', reflections: 'Reflections'} %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>{{ plan.topic ?: 'Lesson plan' }}</h1>
            <p>{{ load.teacher.fullName }} · {{ load.subject.name }} · {{ load.section.gradeLevel ? load.section.gradeLevel.label }} {{ load.section.name }} · week of {{ plan.weekStart|date('F j, Y') }}</p>
        </div>
        <div class="row-actions">
            <a class="btn btn--primary" href="{{ path('lesson_plan_pdf', {id: plan.id}) }}" data-turbo="false">Download PDF</a>
            {% if is_granted('ROLE_PRINCIPAL') %}<a class="btn btn--ghost" href="{{ path('principal_lesson_plans') }}">Lesson Plans</a>{% endif %}
        </div>
    </div>

    <div class="card form-card">
        <h2>Learning competencies</h2>
        <ul>{% for c in plan.competencies|split('\n')|map(l => l|trim)|filter(l => l != '') %}<li>{{ c }}</li>{% endfor %}</ul>
    </div>

    {% for day in plan.days %}
        <div class="card form-card">
            <h2>Day {{ loop.index }} · {{ day.date|date('l, F j') }}</h2>
            {% if day.holiday %}
                <p><strong>HOLIDAY</strong> ({{ day.holiday }})</p>
            {% else %}
                <dl class="details">
                    {% for field, label in labels %}
                        <div><dt>{{ label }}</dt><dd>{% for line in day[field]|split('\n')|map(l => l|trim)|filter(l => l != '') %}• {{ line }}<br>{% else %}—{% endfor %}</dd></div>
                    {% endfor %}
                </dl>
            {% endif %}
        </div>
    {% endfor %}
{% endblock %}
