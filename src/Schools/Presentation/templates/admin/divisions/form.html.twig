{% extends '@Core/admin/_layout.html.twig' %}

{% set heading = division ? 'Edit division' : 'Add division' %}

{% block title %}{{ heading }} · ZIM School{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>{{ heading }}</h1>
            <p>The Superintendent's name, position and signature print on the IDs of this division's principals.</p>
        </div>
    </div>

    <div class="card form-card">
        {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
            <div class="form-grid" data-controller="region-division" data-region-division-map-value="{{ form.vars.division_map|json_encode }}">
                {{ form_row(form.region) }}
                {{ form_row(form.name) }}
            </div>
            {{ form_row(form.sdsName) }}
            {{ form_row(form.sdsPosition) }}
            {% if division and division.signaturePath %}
                <p><img src="{{ asset(division.signaturePath) }}" alt="Current signature" style="max-height: 60px"></p>
            {% endif %}
            {{ form_row(form.signature) }}

            <div class="form-actions">
                <button class="btn btn--primary" type="submit">{{ division ? 'Save division' : 'Add division' }}</button>
                <a class="link-muted" href="{{ path('admin_divisions') }}">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
