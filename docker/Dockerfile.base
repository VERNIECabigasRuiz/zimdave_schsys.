FROM php:8.4-fpm

ENV DEBIAN_FRONTEND=noninteractive

# System tools, web server and process manager
RUN apt-get update && apt-get install -y \
    git \
    zip \
    unzip \
    curl \
    gnupg \
    libicu-dev \
    libonig-dev \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libwebp-dev \
    libxml2-dev \
    nginx \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# PHP extensions (gd and mbstring are also needed by dompdf, exif for photo orientation)
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install \
    pdo_mysql \
    intl \
    mbstring \
    xml \
    zip \
    gd \
    exif \
    opcache

# pcov for PHPUnit code coverage (off by default, see php.ini)
RUN pecl install pcov && docker-php-ext-enable pcov

# Custom PHP settings
COPY config/php.ini /usr/local/etc/php/conf.d/zz-custom.ini

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Node 24 and pnpm (through Corepack) for the asset build and JS checks
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && corepack enable \
    && corepack prepare pnpm@latest --activate \
    && rm -rf /var/lib/apt/lists/*

# Chrome for the browser tests
RUN curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Nginx: SSL cert/key + site config
COPY config/ssl/cert.pem /etc/nginx/ssl/cert.pem
COPY config/ssl/key.pem /etc/nginx/ssl/key.pem
COPY config/nginx.conf /etc/nginx/sites-available/default

# Supervisord: runs nginx, php-fpm and the messenger worker
COPY config/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 443

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
