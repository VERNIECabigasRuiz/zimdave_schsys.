<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="reports/phpunit/.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <!-- Browser tests: the kernel runs in the test env, Chrome runs as root in the container -->
        <server name="PANTHER_APP_ENV" value="test" force="true" />
        <server name="PANTHER_NO_SANDBOX" value="1" />
        <server name="PANTHER_CHROME_ARGUMENTS" value="--disable-dev-shm-usage" />
    </php>

    <testsuites>
        <testsuite name="unit">
            <directory>tests/*/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/*/Integration</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/*/Functional</directory>
        </testsuite>
        <testsuite name="browser">
            <directory>tests/Browser</directory>
        </testsuite>
        <!-- Tests not yet moved into a module; each move takes its folders out of here -->
        <testsuite name="legacy">
            <directory>tests/Controller</directory>
            <directory>tests/Repository</directory>
            <file>tests/KernelTimezoneTest.php</file>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src/Core</directory>
            <directory>src/Access</directory>
            <directory>src/Billing</directory>
            <directory>src/Schools</directory>
            <directory>src/Classes</directory>
            <directory>src/Learners</directory>
            <directory>src/Attendance</directory>
            <directory>src/Grading</directory>
            <directory>src/Nutrition</directory>
            <directory>src/LessonPlans</directory>
            <directory>src/Staff</directory>
            <directory>src/Announcements</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
        <bootstrap class="Symfony\Component\Panther\ServerExtension" />
    </extensions>
</phpunit>
